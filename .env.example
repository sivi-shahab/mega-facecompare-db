# .env.example — compreface-postgres-db. Salin ke .env lalu isi nilai yang ditandai WAJIB. (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/base. JANGAN isi nilai asli di file ini.
POSTGRES_DB=frs
# subdirektori agar aman di PVC
PGDATA=/var/lib/postgresql/data/pgdata
TZ=Asia/Jakarta
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_USER=
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_PASSWORD=
